# Copy to `.env.local` for local development. Placeholders only — never commit
# real values. DATABASE_URL below matches `docker-compose.yml` defaults
# (local dev only); auth/storage entries are reserved for upcoming phases.

DATABASE_URL="postgresql://app:secret@localhost:4432/restaurant_app"
# TEST_DATABASE_URL="postgresql://app:secret@localhost:4432/restaurant_app"
# Canonical tenant address is `{slug}.{PLATFORM_BASE_DOMAIN}`
# (see `docs/runbooks/platform-subdomains.md`). Unset means `localhost`.
# PLATFORM_BASE_DOMAIN="platform.example"
# AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Optional (Phase 6.1): keys the HMAC in the sign-in rate-limit table, so the
# counters cannot be read back as a list of who tried to sign in. Unset is fine
# — it falls back to AUTH_SECRET, which every environment that can sign anyone
# in already has. Rotating it just resets the counters.
# AUTH_URL="http://localhost:4030"
# AUTH_TRUST_HOST="true"
# Local Mailpit (see `docker-compose.yml`): SMTP on :1025, inbox UI at
# http://localhost:8025. Uncomment for local magic-link sign-in.
# EMAIL_SERVER="smtp://localhost:1025"
# EMAIL_FROM="""Restaurant Platform <noreply@platform.example>"""
# Local upload storage (dev only; git-ignored). Swap for R2 before any
# hosted environment — see `src/lib/storage.ts`.
# STORAGE_DIR="./local/uploads"
# Vercel API for custom-domain routing (Phase 5.3) — see `src/lib/vercel.ts`.
# Project-scoped access token (Vercel: Settings → Account Tokens → scope to
# the project). NEVER commit the real value; put it in `.env.local` only.
# VERCEL_TOKEN=""
# VERCEL_PROJECT_ID=""  # e.g. prj_… from the project's settings
