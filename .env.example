# Copy to `.env.local` for local development, then fill in real values.
# Convention in this file: ACTIVE lines are required for `next dev` (safe
# local defaults — Mailpit, Docker Postgres, a dev-only auth secret);
# COMMENTED lines are optional or opt-in, each marked why. Placeholders
# only — never commit real secrets (`.env.local` is git-ignored).

DATABASE_URL="postgresql://app:secret@localhost:4432/restaurant_app"
# Auth (required to sign in — NextAuth v5 magic links). The secret below is
# dev-only: generate a real one per hosted environment with
# `openssl rand -base64 32` and set it in Vercel env instead.
AUTH_SECRET="dev-only-insecure-use-openssl-rand-base64-32-for-hosting"
AUTH_URL="http://localhost:4030"
AUTH_TRUST_HOST="true"
# Local Mailpit (see `docker-compose.yml`): SMTP on :1025, inbox UI at
# http://localhost:8025. Required for local magic-link sign-in.
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="Restaurant Platform <noreply@platform.example>"
# Optional: run the live database suites (`TEST_DATABASE_URL` present =
# they run; absent = they skip). Same Docker Postgres works fine.
# TEST_DATABASE_URL="postgresql://app:secret@localhost:4432/restaurant_app"
# Optional: canonical tenant address is `{slug}.{PLATFORM_BASE_DOMAIN}`
# (see `docs/runbooks/platform-subdomains.md`). Unset means `localhost`.
# PLATFORM_BASE_DOMAIN="platform.example"
# Optional: local upload storage (dev only; git-ignored). Has a code
# default (`local/uploads`) — set only to override it. Swap for R2 before
# any hosted environment — see `src/lib/storage.ts` and
# `docs/plans/r2-storage-swap.md`.
# STORAGE_DIR="./local/uploads"
# Optional: object storage driver (`fs` = local filesystem, `r2` =
# Cloudflare R2 via the S3-compatible API in `src/lib/storage-r2.ts`).
# Default is `r2` when `R2_ACCOUNT_ID` is set, `fs` otherwise — set
# explicitly only when overriding that default.
# STORAGE_DRIVER="fs"
# Optional (required for the R2 driver / any hosted environment):
# Cloudflare R2 (S3-compatible) — bucket stays private, served via
# `/api/images/[...key]`. Mirror the same four names in Vercel env
# (Production + Preview) and `.env.local`. Setup: R2 → Create bucket,
# then Manage R2 API Tokens → Object Read & Write scoped to that bucket
# (secret shown once), plus the account ID from the R2 overview page.
# See `docs/plans/r2-storage-swap.md` for details.
# R2_ACCOUNT_ID=""
# R2_BUCKET=""  # e.g. restaurant-app-images
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# Optional endpoint override (defaults to
# `https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com`).
# R2_ENDPOINT=""
# Optional (required for custom-domain routing — Phase 5.3, see
# `src/lib/vercel.ts`): project-scoped access token (Vercel: Settings →
# Account Tokens → scope to the project). NEVER commit the real value;
# put it in `.env.local` only.
# VERCEL_TOKEN=""
# VERCEL_PROJECT_ID=""  # e.g. prj_… from the project's settings
